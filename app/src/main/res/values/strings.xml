    <string name="welcome_title">Welcome to Air Controle</string>
    <string name="welcome_body">Hands-free phone control with the camera. A white cursor follows your fingertip. AIR OS power, Arabic-first, built for everyday gestures.</string>
    <string name="action_get_started">Get started</string>
    <string name="action_continue">Continue</string>
