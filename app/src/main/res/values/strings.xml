    <string name="onboarding_camera_title">Camera</string>
    <string name="onboarding_camera_body">Air Controle watches your hand — not your face — to move the cursor and read gestures. The feed stays on-device.</string>
    <string name="onboarding_accessibility_title">Accessibility</string>
    <string name="onboarding_accessibility_body">The Accessibility Service performs Home, Back, scroll, and tap at the cursor. Android requires you to turn this on yourself. You can disable it any time.</string>
    <string name="onboarding_overlay_title">Overlay cursor</string>
    <string name="onboarding_overlay_body">A white fingertip cursor draws over other apps so you can see where a gesture will land.</string>
    <string name="onboarding_notifications_title">Notifications</string>
    <string name="onboarding_notifications_body">A persistent notification is how Android lets Air Control keep running after you leave the app. It is also the honest off switch.</string>
    <string name="onboarding_ready_title">You are ready</string>
    <string name="onboarding_ready_body">Turn Air Control on from Home. Point to move the cursor. Pinch to click. Palm to pause. Fist for Back. Peace for Home.</string>
