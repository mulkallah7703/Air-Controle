    <string name="settings_purchase">Unlock</string>
    <string name="settings_purchase_body">Air Controle is planned as a one-time purchase for 29.99 SAR. Billing is not wired in this build — this is a note only.</string>
    <string name="settings_purchase_price">29.99 SAR · one time</string>
    <string name="settings_version">Version %1$s</string>
    <string name="settings_limits_title">Honest Android limits</string>
    <string name="settings_limits_body">Stock Android will not let any app fully shut the phone down, survive every OEM battery killer, or inject input without Accessibility. Air Controle asks only for what it needs and tells you when the system is in the way.</string>

    <string name="coming_soon_training_title">Gesture training</string>
    <string name="coming_soon_training_body">Guided practice for click, scroll, swipe, palm, fist, and peace will land in a later build. For now the default gestures are live.</string>
    <string name="coming_soon_customize_title">Full customization</string>
    <string name="coming_soon_customize_body">Remapping gestures and per-app profiles is planned. This screen is a stub so the path is already in the app.</string>
